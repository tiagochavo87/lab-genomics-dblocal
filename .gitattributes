# Garante finais de linha corretos em qualquer sistema (Windows usa CRLF por
# padrão, mas scripts que rodam dentro do Docker/Linux precisam de LF).
* text=auto
*.sh text eol=lf
*.sql text eol=lf
Caddyfile text eol=lf
backup/* text eol=lf
docker/* text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.ico binary
*.docx binary
*.woff binary
*.woff2 binary
