# Copie para ".env" (na mesma pasta do docker-compose.local.yml) e preencha.
# NUNCA versione o ".env". Gere valores fortes com:
#   openssl rand -hex 32   -> JWT_SECRET
#   openssl rand -hex 24   -> POSTGRES_PASSWORD, APP_DB_PASSWORD
# Use só letras e números nas senhas do banco (vão dentro de uma URL).
# Ou rode ./scripts/gerar-env.sh, que cria este arquivo com tudo sorteado.

POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
# Opcional: chave separada para cifrar segredos dos destinos de backup.
SETTINGS_ENCRYPTION_KEY=

INITIAL_ADMIN_EMAIL=admin@local.test
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador

# Endereço usado pelos usuários (modo sem Caddy).
CORS_ORIGIN=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080/reset-password

# --- Acesso remoto (docker-compose.remote.yml) ---
# Domínio com DNS apontando para este servidor (portas 80/443 liberadas).
DOMAIN=localhost

# --- E-mail (recuperação de senha) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DBLAPOGE <no-reply@suainstituicao.org>"

# --- Backup diário ---
BACKUP_TIME=12:30
BACKUP_RETENTION_DAYS=30
# Com senha, os arquivos saem cifrados (AES-256). GUARDE essa senha fora do
# servidor: sem ela o backup não pode ser restaurado.
BACKUP_PASSPHRASE=
# Pasta do host onde os backups são gravados (de preferência outro disco ou
# uma pasta sincronizada com a nuvem).
BACKUP_HOST_DIR=./backups

# --- Outros ---
TZ=America/Sao_Paulo
# Papéis que veem dados identificáveis sem máscara.
UNMASKED_ROLES=admin
PASSWORD_MIN_LENGTH=10
JWT_EXPIRES_IN=12h
