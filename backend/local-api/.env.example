# Configuração da API para desenvolvimento / instalação manual.
# (No Docker as variáveis vêm do .env da raiz; no Windows o instalador gera este arquivo.)
PORT=3001
# Use o usuário sem superusuário criado por scripts/db-setup.sql.
DATABASE_URL=postgres://dblapoge_app:SENHA@localhost:5432/dblapoge

# OBRIGATÓRIO: 32+ caracteres aleatórios. Gere com: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
SETTINGS_ENCRYPTION_KEY=

CORS_ORIGIN=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080/reset-password
# "1" apenas se houver proxy reverso (Caddy) na frente. Vazio no acesso direto.
TRUST_PROXY=
HTTPS=false
HTTPS_PFX_PATH=
HTTPS_PFX_PASSPHRASE=

UNMASKED_ROLES=admin
PASSWORD_MIN_LENGTH=10
BODY_LIMIT=50mb

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DBLAPOGE <no-reply@suainstituicao.org>"

INITIAL_ADMIN_EMAIL=admin@local.test
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador
