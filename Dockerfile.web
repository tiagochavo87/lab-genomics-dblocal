# Build de produção do frontend, servido pelo Caddy (ver Caddyfile e
# docker-compose.remote.yml). VITE_API_URL vazio: o Caddy serve o frontend e
# faz proxy da API no mesmo domínio (sem CORS, porta 3001 não exposta).
FROM node:24-bookworm-slim AS build
WORKDIR /app
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
